{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BridgeDeck",
  "version": "0.9.1",
  "identifier": "dev.bridgedeck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BridgeDeck",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* bdbook: http://bdbook.localhost https://bdbook.localhost; script-src 'self'; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../runtime/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "fileAssociations": [
      {
        "ext": [],
        "name": "Send with BridgeDeck",
        "contentTypes": [
          "public.data",
          "public.folder"
        ],
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
