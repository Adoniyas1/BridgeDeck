{
  "name": "bridgedeck",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "agent": "node agent/bridge-agent.mjs",
    "vendor:fetch": "node scripts/vendor.mjs fetch",
    "vendor:verify": "node scripts/vendor.mjs verify",
    "package:source": "node scripts/package-source.mjs",
    "build:mac": "sh scripts/build-macos.sh",
    "build:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "vendor:bundle": "node scripts/vendor.mjs fetch && node scripts/package-source.mjs",
    "agent:token": "node agent/generate-token.mjs",
    "vendor:reuse": "node scripts/reuse-vendor.mjs",
    "runtime:init": "node scripts/runtime.mjs init",
    "runtime:status": "node scripts/runtime.mjs status",
    "runtime:build": "node scripts/build-syncthing.mjs",
    "package:bootstrap": "node scripts/package-bootstrap.mjs",
    "runtime:import": "node scripts/import-runtime.mjs",
    "verify:project": "node scripts/verify-project.mjs",
    "upgrade:previous": "sh scripts/upgrade-from-previous.sh",
    "verify:localsend-core": "node scripts/verify-localsend-core.mjs",
    "test": "vitest run",
    "mac:signing": "bash scripts/mac-signing.sh"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@huggingface/transformers": "^3.8.1",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "avr8js": "0.21.1",
    "epubjs": "^0.3.93",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^4.10.38",
    "perfect-freehand": "^1.2.2",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "replicad": "1.1.0",
    "replicad-opencascadejs": "1.1.0",
    "replicad-threejs-helper": "1.0.0",
    "tesseract.js": "^7.0.0",
    "three": "0.186.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
